        <mxCell id="panel_loss" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF0EE;strokeColor=#C78B85;fillOpacity=32;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="570" width="1220" height="220" as="geometry"/>
        </mxCell>

        <!-- Title and headings -->
        <mxCell id="title" value="GAST: Evidence-Conditioned Trajectory Forecasting from Incomplete Histories" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#202124;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="OES · GERE · ECTA (RMCM + EWSA) · GCI Decoder · direct prediction without imputation · K=20 · 12 steps" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#5F6368;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="1220" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="head_input" value="(a) Incomplete History" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#233047;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="42" y="120" width="201" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="head_encoder" value="(b) GAST Encoder" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#315A34;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="312" y="120" width="376" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="head_decoder" value="&lt;b&gt;(c) GCI Decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Goal-Conditioned Interaction Decoder&lt;/font&gt;" style="text;html=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontColor=#563A72;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="732" y="120" width="326" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="head_output" value="(d) Forecast" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#245A5A;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1102" y="120" width="136" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="head_loss" value="Training-only supervision" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#7B3E38;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="42" y="580" width="300" height="22" as="geometry"/>
        </mxCell>

        <!-- Inputs -->
        <mxCell id="input_history" value="&lt;b&gt;History feature [B, N, T, 4]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Δx, Δy (position difference)&lt;br&gt;Δv (speed change)&lt;br&gt;m (validity mask)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=11;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="42" y="170" width="201" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="input_masks" value="&lt;b&gt;Validity masks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;x_valid_mask · x_key_valid_mask&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#7B8A9A;fontColor=#3C4043;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="42" y="260" width="201" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="input_positions" value="&lt;b&gt;Observed positions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;x_positions (local xy)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#7B8A9A;fontColor=#3C4043;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="42" y="325" width="201" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="input_note" value="T = 8 observed steps · dt = 0.4 s&lt;br&gt;no external imputation · actor-only&lt;br&gt;no map or lane graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5F6368;fontFamily=Times New Roman;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="42" y="390" width="201" height="55" as="geometry"/>
        </mxCell>

        <!-- Encoder -->
        <mxCell id="evidence_state" value="&lt;b&gt;① OES · Observation Evidence State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;s: observed · a = t − last observed&lt;br&gt;r = 1 if s=1, else exp(−τ·a)&lt;br&gt;τ = softplus(θ), learnable · padding excluded&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="315" y="160" width="370" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="gere_gsm" value="&lt;b&gt;② GERE · Geometry-Evidence Relational Encoding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;7-D pair geometry → per-head attention bias&lt;br&gt;source eligibility gating · ghost token · key padding&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="315" y="245" width="370" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="ecta_group" value="&lt;b&gt;③ ECTA · RMCM + EWSA&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E8449;dashed=1;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="315" y="330" width="370" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rmcm" value="&lt;b&gt;RMCM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;reliability-modulated&lt;br&gt;causal Mamba ×4&lt;br&gt;r_t × MLP(z_t)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#1E8449;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="325" y="360" width="155" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ewsa" value="&lt;b&gt;EWSA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;w_t = softmax(q_t + β log r_t)&lt;br&gt;h = r_T h_T +&lt;br&gt;(1−r_T) Σ w_t h_t&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#1E8449;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="525" y="360" width="155" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="actor_encoding" value="&lt;b&gt;Actor Tokens [B, N, 128]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;focal actor at index 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=11;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="375" y="465" width="250" height="50" as="geometry"/>
        </mxCell>

        <!-- GCI decoder -->
        <mxCell id="focal_encoding" value="&lt;b&gt;Focal actor token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;index 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="160" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="anchor_gap" value="&lt;b&gt;Anchor state (7-D)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;last valid c · v&lt;br&gt;g/T · ρ · m_T&lt;br&gt;no imputation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE5C6;strokeColor=#B0651A;fontColor=#6E3D0A;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="895" y="160" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mode_queries" value="&lt;b&gt;① Mode queries (K=20)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;focal token + anchor state + mode embedding&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="250" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="context_attn" value="&lt;b&gt;② Actor cross-attention ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;each mode reads valid actor tokens · padding masked&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="325" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="endpoint_head" value="&lt;b&gt;③ Endpoint prediction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Δg = MLP(mode query) · g = c + Δg&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="395" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="trajectory_head" value="&lt;b&gt;④ Time-conditioned trajectory generation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;t_k = (gap+k)·dt · linear path + decaying residual&lt;br&gt;exact endpoint at p=1 · mode score · scale&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4A5A;fontColor=#202124;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="735" y="470" width="320" height="58" as="geometry"/>
        </mxCell>

        <!-- Forecast heads -->
        <mxCell id="prediction_heads" value="&lt;b&gt;Prediction outputs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;trajectory · score · scale&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#1E8449;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
