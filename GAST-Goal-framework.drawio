          <mxGeometry x="1105" y="250" width="130" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="neighbor_heads" value="&lt;b&gt;Neighbor Prediction Head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;training-only auxiliary&lt;br&gt;ŷ_others&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#7B8A9A;fontColor=#3C4043;fontFamily=Times New Roman;fontSize=9;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1105" y="375" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- Training supervision -->
        <mxCell id="gt_traj" value="&lt;b&gt;Ground-truth trajectory y&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;future xy, 12 steps&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C78B85;fontColor=#7B3E38;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="605" width="180" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="gt_endpoint" value="&lt;b&gt;Ground-truth endpoint y_T&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;last future position&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C78B85;fontColor=#7B3E38;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="657" width="180" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="l_main" value="&lt;b&gt;L_main (final-consistent)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;L_main = L_reg + L_cls + L_Laplace&lt;br&gt;+ λ_end·L_endpoint + λ_div·L_diversity&lt;br&gt;best mode: joint trajectory + endpoint error&lt;br&gt;classification target: trajectory error&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="460" y="595" width="360" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="l_others" value="&lt;b&gt;L_others&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SmoothL1(ŷ_others, Y_others)&lt;br&gt;valid neighbors only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="900" y="600" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l_total" value="&lt;b&gt;L_total&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;L_main + L_others&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="900" y="690" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="loss_note" value="GT and losses enter only during training; inference stops at the main outputs." style="text;html=1;fontSize=9;fontStyle=2;align=left;verticalAlign=middle;fontColor=#7B3E38;fontFamily=Times New Roman;" vertex="1" parent="1">
