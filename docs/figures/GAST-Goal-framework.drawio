          <mxGeometry x="315" y="245" width="370" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="ecta_group" value="&lt;b&gt;③ ECTA · temporal aggregation&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E8449;dashed=1;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="315" y="330" width="370" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="rmcm" value="&lt;b&gt;RMCM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;r_t × input&lt;br&gt;causal Mamba ×4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#1E8449;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="325" y="360" width="155" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="ewsa" value="&lt;b&gt;EWSA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;softmax(s_t + β·log r_t)&lt;br&gt;terminal-state blending&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#1E8449;fontColor=#145A32;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="525" y="360" width="155" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="actor_encoding" value="&lt;b&gt;GAST actor encoding [B, N, 128]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;focal actor at index 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=11;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="375" y="465" width="250" height="50" as="geometry"/>
        </mxCell>

        <!-- Decoder -->
        <mxCell id="focal_encoding" value="&lt;b&gt;Focal encoding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;actor 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="160" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="anchor_gap" value="&lt;b&gt;Last-valid anchor state (7-D)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;anchor xy · terminal velocity&lt;br&gt;gap ratio · valid ratio&lt;br&gt;terminal missing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE5C6;strokeColor=#B0651A;fontColor=#6E3D0A;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="895" y="160" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mode_queries" value="&lt;b&gt;K=20 mode queries&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;focal encoding + anchor state + mode embedding&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="250" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="context_attn" value="&lt;b&gt;Actor-context cross-attention ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;attends all actors · padding masked&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="325" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="endpoint_head" value="&lt;b&gt;Goal endpoint head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Δg = MLP(mode query) · endpoint = anchor + Δg&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="395" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="trajectory_head" value="&lt;b&gt;Time-conditioned trajectory head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;t_k = (gap + k)·dt · x_k = anchor + p_k·Δg + (1−p_k)·res_k&lt;br&gt;exact endpoint at p_k = 1 · mode score · Laplace scale&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4A5A;fontColor=#202124;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="735" y="470" width="320" height="58" as="geometry"/>
