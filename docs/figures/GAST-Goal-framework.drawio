        <mxCell id="final_loss" value="&lt;b&gt;Final-consistent loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;L = Lreg + Lcls + Lend + Ldiv + LLaplace + Lothers&lt;br&gt;best mode by joint trajectory + endpoint error&lt;br&gt;classification target ranked by trajectory error&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#7B241C;fontFamily=Times New Roman;fontSize=10;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
