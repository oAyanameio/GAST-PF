        <mxCell id="head_encoder" value="(b) GAST Encoder" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#315A34;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="312" y="120" width="376" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="head_decoder" value="(c) Gap-Aware Goal Decoder" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#563A72;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="732" y="120" width="326" height="24" as="geometry"/>
