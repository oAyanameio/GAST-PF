        </mxCell>
        <mxCell id="input_note" value="T = 8 observed steps · dt = 0.4 s&lt;br&gt;actor-only, no map or lane graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5F6368;fontFamily=Times New Roman;fontSize=9;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="42" y="390" width="201" height="50" as="geometry"/>
        </mxCell>

        <!-- Encoder -->
        <mxCell id="evidence_state" value="&lt;b&gt;① Observation evidence state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;age_t = t − last observed step&lt;br&gt;r_t = 1 if observed, else exp(−τ·age_t)&lt;br&gt;τ = softplus(logit), learnable · padding excluded&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#6C4A8A;fontColor=#3A2560;fontFamily=Times New Roman;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
