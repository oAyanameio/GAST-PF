        <!-- Inputs -->
        <mxCell id="input_history" value="&lt;b&gt;History feature [B, N, T, 4]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Δp (relative position)&lt;br&gt;Δs (speed difference)&lt;br&gt;m (valid mask)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3A5A8A;fontColor=#1B2A3B;fontFamily=Times New Roman;fontSize=11;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
