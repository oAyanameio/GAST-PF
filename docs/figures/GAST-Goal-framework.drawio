        <mxCell id="head_output" value="(d) Forecast" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#245A5A;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1102" y="120" width="136" height="24" as="geometry"/>
