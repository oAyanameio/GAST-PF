        <!-- Title and headings -->
        <mxCell id="title" value="GAST: Evidence-Conditioned Goal-Aware Trajectory Forecasting" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#202124;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Direct prediction from incomplete history · actor-only · K=20 modes · 12 future steps · no imputation" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#5F6368;fontFamily=Times New Roman;" vertex="1" parent="1">
